Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Dominio con guion y www → dominio principal (una sola URL para Google).
  RewriteCond %{HTTP_HOST} ^(www\.)?santafe-propiedades\.com\.ar$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.santafepropiedades\.com\.ar$ [NC]
  RewriteRule ^ https://santafepropiedades.com.ar%{REQUEST_URI} [L,R=301]

  # HTTPS obligatorio (salvo en desarrollo local).
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Lo que no es un archivo real va al controlador frontal.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Las fotos subidas nunca se ejecutan como PHP.
<If "%{REQUEST_URI} =~ m#^/uploads/#">
  <FilesMatch "\.(php|phtml|phar)$">
    Require all denied
  </FilesMatch>
</If>
